<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/charts_daily"
            android:layout_margin="8dp"
            android:textColor="@android:color/black" />

        <HorizontalScrollView
            android:id="@+id/bar_chart_scroll"
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <im.dacer.androidcharts.BarView
                    android:id="@+id/bar_chart"
                    android:layout_width="wrap_content"
                    android:layout_height="220dp" />

                <!-- BarView is missing space to the right
                     and cannot handle padding attribute   -->
                <View
                    android:layout_width="22dp"
                    android:layout_height="match_parent" />


            </LinearLayout>


        </HorizontalScrollView>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/charts_clock_pie"
            android:layout_margin="8dp"
            android:textColor="@android:color/black" />

        <im.dacer.androidcharts.ClockPieView
            android:id="@+id/clock_chart"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/charts_wip"
            android:layout_margin="8dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>