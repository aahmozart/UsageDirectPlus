<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <activity
            android:name=".activity.ColorActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:parentActivityName=".activity.SourceAppUsageStatisticsActivity"
            android:label="@string/menu_color" />

        <activity
            android:name=".activity.UsageIntervalsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:parentActivityName=".activity.SourceAppUsageStatisticsActivity"
            android:label="@string/usage_intervals_title" />

        <activity
            android:name=".activity.BrowserTabSessionsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:parentActivityName=".activity.UsageIntervalsActivity"
            android:label="@string/browser_tab_sessions_title" />

        <activity
            android:name=".activity.ExportSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:parentActivityName=".activity.SourceAppUsageStatisticsActivity"
            android:label="@string/menu_export_settings" />

        <service android:name=".persistence.EventLogService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <service
            android:name=".persistence.BrowserCaptureAccessibilityService"
            android:description="@string/browser_capture_service_description"
            android:exported="false"
            android:label="@string/browser_capture_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/browser_capture_accessibility_service" />
        </service>

        <receiver android:name=".widget.TimeTodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_time_today" />
        </receiver>

    </application>

</manifest>
