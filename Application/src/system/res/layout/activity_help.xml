<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_unreliable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_bug_1"
            android:drawableStart="@drawable/ic_bug"
            android:drawablePadding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_bug_2"
            android:drawableStart="@drawable/ic_bug"
            android:drawablePadding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_bug_3"
            android:drawableStart="@drawable/ic_bug"
            android:drawablePadding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_bug_4"
            android:drawableStart="@drawable/ic_bug"
            android:drawablePadding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_bug_5"
            android:drawableStart="@drawable/ic_bug"
            android:drawablePadding="8dp"/>

        <LinearLayout
            android:id="@+id/database_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:padding="8dp"
            android:orientation="horizontal"
            android:foreground="?android:attr/selectableItemBackground"
            android:background="#e1f5fe"
            android:focusable="true"
            android:clickable="true"
            android:elevation="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_flavor_database"
                android:layout_margin="8dp"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/text_database"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#01579b"
                android:text="@string/help_database_flavor"
                android:layout_margin="8dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/help_reliable" />

    </LinearLayout>

</ScrollView>